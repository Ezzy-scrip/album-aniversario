<style>
/* =========================================================
   CONFIGURACIÓN GENERAL
========================================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #020201;
    color: #fff4b0;
    font-family: Georgia, "Times New Roman", serif;
    overflow-x: hidden;
}

button {
    font-family: inherit;
}

:root {
    --gold: #ffd83d;
    --gold-light: #fff09a;
    --gold-dark: #9d7300;
    --yellow: #ffc928;
    --black: #020201;
}


/* =========================================================
   FONDO
========================================================= */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 999;

    background:
        radial-gradient(
            circle at 50% 35%,
            rgba(255, 205, 30, .08),
            transparent 35%
        );

    animation: breathing 5s ease-in-out infinite;
}

@keyframes breathing {
    0%,100% {
        opacity: .5;
    }

    50% {
        opacity: 1;
    }
}


/* =========================================================
   ESTRELLAS
========================================================= */

.stars {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
}

.star {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #ffe76b;

    box-shadow:
        0 0 5px #ffd21f,
        0 0 12px #ffd21f;

    animation: twinkle 2s infinite ease-in-out;
}

@keyframes twinkle {
    0%,100% {
        opacity: .15;
        transform: scale(.7);
    }

    50% {
        opacity: 1;
        transform: scale(1.5);
    }
}


/* =========================================================
   SECCIONES
========================================================= */

section {
    min-height: 100vh;
    position: relative;
    z-index: 2;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 80px 20px;
}


/* =========================================================
   EFECTO DORADO
========================================================= */

.gold-text {
    color: var(--gold);
    text-shadow:
        0 0 5px #fff0a0,
        0 0 15px #ffc400,
        0 0 35px rgba(255, 191, 0, .65);
}


/* =========================================================
   PRIMERA PANTALLA
========================================================= */

.hero {
    text-align: center;
    min-height: 100vh;

    background:
        radial-gradient(
            circle at center,
            rgba(90, 67, 0, .23),
            transparent 55%
        );
}

.hero-content {
    max-width: 1000px;
    animation: appear 1.5s ease;
}

.date {
    font-family: monospace;
    letter-spacing: 9px;
    color: #e4bc32;
    font-size: 14px;
    margin-bottom: 35px;
}

.hero-title {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 35px;

    font-size: clamp(45px, 7vw, 90px);
    line-height: 1.1;
}

.heart {
    font-size: clamp(55px, 8vw, 100px);

    background: linear-gradient(
        135deg,
        #fff06a,
        #ffb321,
        #ff6c5c
    );

    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;

    filter:
        drop-shadow(0 0 8px #ffd21f)
        drop-shadow(0 0 25px #ffb900);

    animation: heartbeat 1.6s infinite;
}

@keyframes heartbeat {
    0%,100% {
        transform: scale(1);
    }

    15% {
        transform: scale(1.12);
    }

    30% {
        transform: scale(1);
    }

    45% {
        transform: scale(1.07);
    }
}

.hero-subtitle {
    margin-top: 30px;
    font-size: 18px;
    color: #eee2ae;
}

.open-button {
    margin-top: 40px;

    padding: 14px 35px;

    background: transparent;
    color: var(--gold-light);

    border: 1px solid var(--gold);
    border-radius: 50px;

    font-size: 16px;

    cursor: pointer;

    box-shadow:
        0 0 10px rgba(255, 208, 30, .15);

    transition: .35s;
}

.open-button:hover {
    background: rgba(255, 208, 30, .1);

    box-shadow:
        0 0 15px rgba(255, 208, 30, .5),
        inset 0 0 15px rgba(255, 208, 30, .08);

    transform: translateY(-3px);
}


/* =========================================================
   FLORES
========================================================= */

.flower-section {
    overflow: hidden;
    align-items: flex-end;
}

.flower-content {
    position: absolute;
    top: 13%;
    text-align: center;
    width: 100%;
}

.small-title {
    font-size: 12px;
    letter-spacing: 7px;
    color: #d4af32;
    text-transform: uppercase;
}

.flower-title {
    font-size: clamp(40px, 6vw, 70px);
    margin-top: 18px;
}

.flower-subtitle {
    margin-top: 15px;
    color: #ded5ae;
}

.flowers {
    position: absolute;
    bottom: -30px;
    left: 50%;

    transform: translateX(-50%);

    width: min(800px, 100%);
    height: 350px;
}

.flower {
    position: absolute;
    bottom: 0;

    transform-origin: bottom center;

    animation: sway 4s ease-in-out infinite;
}

.flower:nth-child(1) {
    left: 20%;
    transform: scale(.7);
}

.flower:nth-child(2) {
    left: 35%;
    animation-delay: -.8s;
}

.flower:nth-child(3) {
    left: 50%;
    transform: scale(1.25);
    animation-delay: -1.5s;
}

.flower:nth-child(4) {
    left: 65%;
    animation-delay: -2s;
}

.flower:nth-child(5) {
    left: 80%;
    transform: scale(.7);
    animation-delay: -2.5s;
}

@keyframes sway {
    0%,100% {
        transform: rotate(-2deg);
    }

    50% {
        transform: rotate(3deg);
    }
}

.stem {
    width: 5px;
    height: 260px;

    background: linear-gradient(
        to right,
        #285900,
        #67a900,
        #285900
    );

    margin: auto;
    border-radius: 10px;
}

.flower-head {
    position: absolute;
    bottom: 240px;
    left: 50%;

    transform: translateX(-50%);

    width: 100px;
    height: 100px;
}

.petal {
    position: absolute;

    width: 45px;
    height: 70px;

    left: 27px;
    top: 10px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle at 50% 80%,
            #ff9d00,
            #ffe75c 55%,
            #fff2a1
        );

    transform-origin: center bottom;
}

.petal:nth-child(1) {
    transform: rotate(0deg) translateY(-25px);
}

.petal:nth-child(2) {
    transform: rotate(45deg) translateY(-25px);
}

.petal:nth-child(3) {
    transform: rotate(90deg) translateY(-25px);
}

.petal:nth-child(4) {
    transform: rotate(135deg) translateY(-25px);
}

.petal:nth-child(5) {
    transform: rotate(180deg) translateY(-25px);
}

.petal:nth-child(6) {
    transform: rotate(225deg) translateY(-25px);
}

.petal:nth-child(7) {
    transform: rotate(270deg) translateY(-25px);
}

.petal:nth-child(8) {
    transform: rotate(315deg) translateY(-25px);
}

.flower-center {
    position: absolute;

    width: 38px;
    height: 38px;

    left: 31px;
    top: 31px;

    border-radius: 50%;

    background:
        radial-gradient(
            circle,
            #7a4700,
            #bc7600,
            #5b3700
        );

    box-shadow:
        0 0 10px #ffbe18;
}


/* =========================================================
   CARTAS
========================================================= */

.letters-section {
    flex-direction: column;
    text-align: center;

    background:
        radial-gradient(
            circle at center,
            rgba(70, 51, 0, .18),
            transparent 55%
        );
}

.section-label {
    color: #d5ad28;
    letter-spacing: 6px;
    font-size: 11px;
    text-transform: uppercase;
}

.section-title {
    margin-top: 18px;

    font-size: clamp(40px, 6vw, 70px);

    color: var(--gold);

    text-shadow:
        0 0 10px #ffd21f,
        0 0 25px rgba(255, 196, 0, .5);
}

.section-description {
    color: #ddd4ac;
    margin-top: 12px;
}

.cards {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(180px, 1fr));

    gap: 24px;

    width: min(950px, 100%);

    margin-top: 60px;
}

.card {
    min-height: 245px;

    padding: 35px 20px;

    border: 1px solid rgba(218, 172, 25, .45);

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            rgba(78, 59, 0, .35),
            rgba(20, 17, 2, .7)
        );

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    cursor: pointer;

    transition:
        transform .4s,
        border .4s,
        box-shadow .4s;
}

.card:hover {
    transform: translateY(-10px);

    border-color: var(--gold);

    box-shadow:
        0 0 20px rgba(255, 204, 35, .15),
        inset 0 0 30px rgba(255, 204, 35, .05);
}

.card-icon {
    font-size: 45px;
    margin-bottom: 25px;

    filter:
        drop-shadow(0 0 8px rgba(255, 200, 30, .6));
}

.card h3 {
    color: #ffe9a0;
    font-size: 17px;
    line-height: 1.5;
}

.card-button {
    margin-top: 25px;

    color: #c9a52a;

    font-size: 11px;

    letter-spacing: 3px;

    text-transform: uppercase;
}


/* =========================================================
   MODAL DE CARTA
========================================================= */

.modal {
    position: fixed;
    inset: 0;

    z-index: 5000;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 25px;

    background: rgba(0,0,0,.86);

    backdrop-filter: blur(8px);
}

.modal.active {
    display: flex;
}

.letter {
    width: min(600px, 100%);

    max-height: 80vh;
    overflow-y: auto;

    padding: 45px;

    border: 1px solid #c69b19;
    border-radius: 15px;

    background:
        radial-gradient(
            circle at top,
            #211900,
            #080700 70%
        );

    box-shadow:
        0 0 50px rgba(255, 196, 0, .2);

    text-align: center;

    animation: modalIn .5s ease;
}

@keyframes modalIn {
    from {
        opacity: 0;
        transform: scale(.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

.letter-icon {
    font-size: 50px;
}

.letter h2 {
    margin: 20px 0 25px;

    color: var(--gold);

    text-shadow:
        0 0 15px #ffc400;
}

.letter p {
    color: #e8dfbd;

    line-height: 1.9;

    margin-bottom: 18px;
}

.close-modal {
    margin-top: 15px;

    border: 1px solid #b99016;

    background: transparent;

    color: #e4c54c;

    padding: 10px 25px;

    border-radius: 30px;

    cursor: pointer;
}


/* =========================================================
   ÁLBUM
========================================================= */

.album-section {
    flex-direction: column;
    text-align: center;

    min-height: 100vh;

    background:
        radial-gradient(
            circle at center,
            rgba(74, 54, 0, .2),
            transparent 55%
        );
}

.album {
    width: min(1000px, 100%);
    margin-top: 55px;
}

.photo-viewer {
    position: relative;

    width: 100%;
    height: 550px;

    overflow: hidden;

    border-radius: 20px;

    border: 1px solid rgba(220, 174, 27, .55);

    background: #090806;

    box-shadow:
        0 0 40px rgba(255, 196, 0, .08);
}

.photo {
    position: absolute;

    inset: 0;

    opacity: 0;

    transition:
        opacity .8s ease,
        transform .8s ease;

    transform: scale(1.05);
}

.photo.active {
    opacity: 1;
    transform: scale(1);
}

.photo img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    display: block;

    filter:
        brightness(.75)
        saturate(.9);
}

.photo::after {
    content: "";

    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            to top,
            rgba(0,0,0,.8),
            transparent 50%
        );
}

.photo-caption {
    position: absolute;

    bottom: 30px;
    left: 35px;
    right: 35px;

    z-index: 2;

    text-align: left;
}

.photo-caption h3 {
    color: #ffe36a;

    font-size: 27px;

    text-shadow:
        0 0 10px #d99f00;
}

.photo-caption p {
    color: #eee2ba;

    margin-top: 8px;
}


/* =========================================================
   CONTROLES DEL ÁLBUM
========================================================= */

.album-controls {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 25px;

    margin-top: 25px;
}

.album-button {
    width: 48px;
    height: 48px;

    border-radius: 50%;

    border: 1px solid #b88d13;

    background: rgba(40, 30, 0, .7);

    color: #ffdb4a;

    font-size: 22px;

    cursor: pointer;

    transition: .3s;
}

.album-button:hover {
    background: #4a3700;

    box-shadow:
        0 0 15px rgba(255, 204, 30, .3);
}

.dots {
    display: flex;
    gap: 8px;
}

.dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #584813;

    cursor: pointer;

    transition: .3s;
}

.dot.active {
    width: 25px;
    border-radius: 10px;

    background: #e7bd2c;

    box-shadow:
        0 0 10px #e7bd2c;
}


/* =========================================================
   FINAL
========================================================= */

.final-section {
    text-align: center;

    min-height: 75vh;

    flex-direction: column;
}

.final-heart {
    font-size: 100px;

    animation: heartbeat 1.5s infinite;

    filter:
        drop-shadow(0 0 15px #ffd000);
}

.final-title {
    margin-top: 25px;

    font-size: clamp(40px, 6vw, 70px);

    color: #ffdf4e;

    text-shadow:
        0 0 15px #ffc400,
        0 0 35px rgba(255, 190, 0, .5);
}

.final-text {
    margin-top: 20px;

    color: #ded5b0;

    font-size: 18px;

    line-height: 1.8;
}


/* =========================================================
   CORAZONES FLOTANTES
========================================================= */

.floating-heart {
    position: fixed;

    bottom: -30px;

    color: #ffd438;

    font-size: 16px;

    pointer-events: none;

    z-index: 1000;

    animation:
        floatUp 7s linear forwards;

    text-shadow:
        0 0 10px #ffc400;
}

@keyframes floatUp {
    0% {
        transform:
            translateY(0)
            rotate(0deg);

        opacity: 0;
    }

    10% {
        opacity: .8;
    }

    90% {
        opacity: .5;
    }

    100% {
        transform:
            translateY(-110vh)
            rotate(360deg);

        opacity: 0;
    }
}


/* =========================================================
   ANIMACIÓN DE ENTRADA
========================================================= */

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 800px) {

    .hero-title {
        gap: 12px;
    }

    .date {
        letter-spacing: 5px;
        font-size: 11px;
    }

    .cards {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .photo-viewer {
        height: 450px;
    }

    .flowers {
        transform:
            translateX(-50%)
            scale(.8);
    }
}


@media (max-width: 550px) {

    section {
        padding: 70px 15px;
    }

    .hero-title {
        flex-direction: column;
        gap: 5px;
    }

    .hero-title .heart {
        font-size: 55px;
    }

    .hero-title {
        font-size: 48px;
    }

    .hero-subtitle {
        font-size: 15px;
    }

    .cards {
        grid-template-columns: 1fr;

        width: 90%;
    }

    .card {
        min-height: 190px;
    }

    .photo-viewer {
        height: 400px;
    }

    .photo-caption {
        left: 20px;
        bottom: 20px;
    }

    .photo-caption h3 {
        font-size: 22px;
    }

    .letter {
        padding: 30px 20px;
    }

    .letter p {
        font-size: 15px;
    }

    .flowers {
        transform:
            translateX(-50%)
            scale(.55);

        bottom: -40px;
    }

    .small-title {
        letter-spacing: 4px;
    }
}
</style>
</head>


