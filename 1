<script>

/* =========================================================
   ESTRELLAS
========================================================= */

const starsContainer =
    document.getElementById("stars");

for (let i = 0; i < 100; i++) {

    const star =
        document.createElement("div");

    star.className = "star";

    star.style.left =
        Math.random() * 100 + "%";

    star.style.top =
        Math.random() * 100 + "%";

    const size =
        Math.random() * 3 + 1;

    star.style.width = size + "px";
    star.style.height = size + "px";

    star.style.animationDelay =
        Math.random() * 4 + "s";

    star.style.animationDuration =
        1.5 + Math.random() * 4 + "s";

    starsContainer.appendChild(star);
}


/* =========================================================
   SCROLL INICIAL
========================================================= */

function abrirRecuerdo() {

    document
        .querySelector(".flower-section")
        .scrollIntoView({
            behavior: "smooth"
        });

    explosionCorazones();
}


/* =========================================================
   CORAZONES
========================================================= */

function crearCorazon() {

    const heart =
        document.createElement("div");

    heart.className =
        "floating-heart";

    heart.innerHTML =
        Math.random() > .5
        ? "♥"
        : "♡";

    heart.style.left =
        Math.random() * 100 + "vw";

    heart.style.fontSize =
        10 + Math.random() * 20 + "px";

    heart.style.animationDuration =
        5 + Math.random() * 6 + "s";

    document.body.appendChild(heart);

    setTimeout(() => {
        heart.remove();
    }, 12000);
}


setInterval(crearCorazon, 900);


/* =========================================================
   EXPLOSIÓN
========================================================= */

function explosionCorazones() {

    for (let i = 0; i < 25; i++) {

        const heart =
            document.createElement("div");

        heart.className =
            "floating-heart";

        heart.innerHTML = "♥";

        heart.style.left =
            45 + Math.random() * 10 + "vw";

        heart.style.bottom =
            30 + Math.random() * 20 + "vh";

        heart.style.fontSize =
            15 + Math.random() * 25 + "px";

        heart.style.animationDuration =
            2 + Math.random() * 3 + "s";

        document.body.appendChild(heart);

        setTimeout(() => {
            heart.remove();
        }, 5000);
    }
}


/* =========================================================
   CARTAS
========================================================= */

const cartas = {

    1: {

        icon: "💌",

        title:
            "Para cuando el día no esté tan lindo",

        text: `
            <p>
                Si estás leyendo esto porque hoy no fue tu mejor día,
                quiero que recuerdes algo:
                <strong>no tienes que poder con todo siempre.</strong>
            </p>

            <p>
                Date un momento, respira y recuerda que hay alguien
                que piensa en ti y que quiere verte sonreír.
            </p>

            <p>
                Ojalá pudiera estar ahí para darte un abrazo,
                pero mientras tanto recibe este pequeño pedacito
                de mi cariño.
            </p>

            <p>
                Mañana será otro día. ❤️
            </p>
        `
    },


    2: {

        icon: "❤️",

        title:
            "Por si alguna vez dudas de ti",

        text: `
            <p>
                Nunca olvides lo increíble que eres.
            </p>

            <p>
                Tal vez algunas veces no puedas ver todas las cosas
                bonitas que los demás vemos en ti.
            </p>

            <p>
                Pero yo sí las veo.
            </p>

            <p>
                Me encanta tu forma de ser, tu manera de hablar,
                tus detalles y esas pequeñas cosas que probablemente
                tú ni siquiera notas.
            </p>

            <p>
                No dudes de lo mucho que vales. ❤️
            </p>
        `
    },


    3: {

        icon: "🌻",

        title:
            "Por si algún día no estoy cerca",

        text: `
            <p>
                Si algún día estamos lejos,
                quiero que recuerdes todos los momentos bonitos
                que hemos compartido.
            </p>

            <p>
                La distancia puede separar dos lugares,
                pero no tiene por qué separar dos corazones.
            </p>

            <p>
                Guarda siempre un poquito de este primer mes
                en tu corazón.
            </p>

            <p>
                Y recuerda que siempre habrá alguien
                pensando en ti. 🌻
            </p>
        `
    },


    4: {

        icon: "✨",

        title:
            "Una última carta",

        text: `
            <p>
                Si llegaste hasta aquí quiero decirte algo
                muy sencillo:
            </p>

            <p>
                <strong>
                    Gracias por este primer mes.
                </strong>
            </p>

            <p>
                Gracias por dejarme formar parte de tu vida,
                por cada conversación, cada risa,
                cada abrazo y cada pequeño momento.
            </p>

            <p>
                No sé qué nos deparará el futuro,
                pero sí sé que quiero seguir creando
                recuerdos contigo.
            </p>

            <p>
                Este fue nuestro primer mes...
                y espero que sea solamente el primero
                de muchos más.
            </p>

            <p>
                Te quiero muchísimo. ❤️
            </p>
        `
    }

};


function abrirCarta(numero) {

    const carta =
        cartas[numero];

    document.getElementById("letterIcon")
        .textContent = carta.icon;

    document.getElementById("letterTitle")
        .textContent = carta.title;

    document.getElementById("letterContent")
        .innerHTML = carta.text;

    document.getElementById("modal")
        .classList.add("active");

    document.body.style.overflow =
        "hidden";
}


function cerrarCarta() {

    document.getElementById("modal")
        .classList.remove("active");

    document.body.style.overflow =
        "";
}


function cerrarSiFuera(event) {

    if (event.target.id === "modal") {
        cerrarCarta();
    }
}


/* =========================================================
   ÁLBUM
========================================================= */

const fotos =
    document.querySelectorAll(".photo");

const dots =
    document.getElementById("dots");

let fotoActual = 0;


/* Crear indicadores */

fotos.forEach((foto, index) => {

    const dot =
        document.createElement("div");

    dot.className = "dot";

    if (index === 0) {
        dot.classList.add("active");
    }

    dot.onclick = () => {
        mostrarFoto(index);
    };

    dots.appendChild(dot);
});


function mostrarFoto(index) {

    if (index >= fotos.length) {
        index = 0;
    }

    if (index < 0) {
        index = fotos.length - 1;
    }

    fotoActual = index;

    fotos.forEach((foto, i) => {

        foto.classList.toggle(
            "active",
            i === fotoActual
        );

    });

    document
        .querySelectorAll(".dot")
        .forEach((dot, i) => {

            dot.classList.toggle(
                "active",
                i === fotoActual
            );

        });
}


function fotoSiguiente() {

    mostrarFoto(
        fotoActual + 1
    );
}


function fotoAnterior() {

    mostrarFoto(
        fotoActual - 1
    );
}


/* =========================================================
   CAMBIO AUTOMÁTICO DEL ÁLBUM
========================================================= */

setInterval(() => {

    fotoSiguiente();

}, 5000);


/* =========================================================
   SWIPE PARA CELULAR
========================================================= */

const viewer =
    document.querySelector(".photo-viewer");

let touchStart = 0;
let touchEnd = 0;

viewer.addEventListener(
    "touchstart",
    event => {

        touchStart =
            event.changedTouches[0].screenX;

    },
    { passive: true }
);


viewer.addEventListener(
    "touchend",
    event => {

        touchEnd =
            event.changedTouches[0].screenX;

        const difference =
            touchStart - touchEnd;

        if (Math.abs(difference) < 50) {
            return;
        }

        if (difference > 0) {
            fotoSiguiente();
        } else {
            fotoAnterior();
        }

    },
    { passive: true }
);


/* =========================================================
   ESC PARA CERRAR CARTA
========================================================= */

document.addEventListener(
    "keydown",
    event => {

        if (event.key === "Escape") {
            cerrarCarta();
        }

        if (event.key === "ArrowRight") {
            fotoSiguiente();
        }

        if (event.key === "ArrowLeft") {
            fotoAnterior();
        }

    }
);

</script>

